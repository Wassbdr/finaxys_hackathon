# Copier en .env (make keys le fait et génère les clés HMAC).
ANTHROPIC_API_KEY=
# claude-haiku-5-5 répond plus vite et coûte moins cher pour des démos longues
ANTHROPIC_MODEL=claude-opus-5-5
REDIS_URL=redis://127.0.0.1:6379/0
# Clé maîtresse de secours : sans HMAC_KEY_<AGENT>, la clé d'un agent en est dérivée.
HMAC_MASTER_SECRET=change-me
